let readingPairs={},readingSelected={};
function readingAnswer(key,v,button){
 if(submitted)return;
 practice[key]=v;
 const parent=button.closest('.reading-question');
 if(parent){parent.querySelectorAll('.choice').forEach(el=>{el.classList.remove('chosen');el.setAttribute('aria-pressed','false')});button.classList.add('chosen');button.setAttribute('aria-pressed','true')}
}
function readingText(key,v){practice[key]=v}
function readingPickWord(key,j){readingSelected[key]=j;updateReadingMatch(key)}
function readingPickMeaning(key,k){const j=readingSelected[key];if(j===undefined||j===null)return;const m=readingPairs[key]||(readingPairs[key]={});for(const x of Object.keys(m)){if(m[x]===k)delete m[x]}m[j]=k;readingSelected[key]=null;updateReadingMatch(key)}
function updateReadingMatch(key){const host=document.getElementById('readingMatch'+key);if(!host)return;const m=readingPairs[key]||{};host.querySelectorAll('[data-word]').forEach(b=>{const j=Number(b.dataset.word);b.classList.toggle('focus',readingSelected[key]===j);b.classList.toggle('paired',m[j]!==undefined);b.setAttribute('aria-pressed',String(readingSelected[key]===j))});host.querySelectorAll('[data-meaning]').forEach(b=>b.classList.toggle('paired',Object.values(m).includes(Number(b.dataset.meaning))));const count=host.querySelector('.matchcount');if(count)count.textContent=Object.keys(m).length+'/3 روابط مكتملة'}
function rotateOptions(arr,seed){const a=arr.slice();const n=a.length;if(n<2)return a;const shift=(seed*7+3)%n;const b=a.slice(shift).concat(a.slice(0,shift));if(b.every((x,i)=>x===a[i]))b.push(b.shift());return b}
function readingQuestionHTML(q,i,story){const key='r'+story+'_'+i;let content='';
 if(['mc','tf','gap'].includes(q.type)){let opts=q.type==='tf'?rotateOptions(['True','False'],story+i):rotateOptions(q.opts,story*17+i);content=`<div class="choices">${opts.map(o=>`<button type="button" class="choice ${practice[key]===o?'chosen':''}" aria-pressed="${practice[key]===o}" onclick='readingAnswer(${JSON.stringify(key)},${JSON.stringify(o)},this)'>${q.type==='tf'?(o==='True'?'True — صحيح':'False — خطأ'):esc(o)}</button>`).join('')}</div>`}
 else if(q.type==='short'){content=`<input class="field en" dir="ltr" style="max-width:360px;font-size:20px" aria-label="اكتب الإجابة" placeholder="Type the missing word" autocomplete="off" spellcheck="false" value="${esc(practice[key]||'')}" oninput='readingText(${JSON.stringify(key)},this.value)'>`}
 else if(q.type==='match'){const order=[2,0,1];content=`<div id="readingMatch${key}" class="matchgrid"><div class="matchcol"><b>English words</b>${q.pairs.map((p,j)=>`<button type="button" class="matchtile en" data-word="${j}" onclick='readingPickWord(${JSON.stringify(key)},${j})'>${esc(p[0])}</button>`).join('')}</div><div class="matchcol"><b>المعاني العربية</b>${order.map(k=>`<button type="button" class="matchtile" data-meaning="${k}" onclick='readingPickMeaning(${JSON.stringify(key)},${k})'>${esc(q.pairs[k][1])}</button>`).join('')}</div></div><p class="muted matchcount">0/3 روابط مكتملة</p>`}
 return `<div class="question reading-question" data-question="${key}"><span class="qnum">QUESTION ${i+1} / 10 · ${q.type==='tf'?'صح أو خطأ':q.type==='gap'?'إكمال فراغ':q.type==='match'?'ربط':q.type==='short'?'كتابة قصيرة':'فهم المقروء'}</span><h3 class="en" style="text-align:left">${esc(q.q)}</h3><p class="instruction">${esc(q.ar)}</p>${content}<div class="reading-feedback" id="feedback_${key}" aria-live="polite"></div></div>`}
function reading(i){const s=S[i],qs=READ_Q[i];return `<div class="storyintro"><div><span class="tag">READING ${i+1} / 3</span><h2 class="en">${esc(s.name)}</h2><p>${esc(s.desc)}</p><button class="btn" onclick='speak(${JSON.stringify(s.lines.join(' '))})'>▶ استمع للمقطع كاملًا</button> <button class="btn secondary" onclick='speak(${JSON.stringify(s.lines.join(' '))},true)'>استماع بطيء</button></div><div class="storyvisual" aria-label="رمز المقطع">${['⚽','🏡','👭'][i]}</div></div>${audioBar()}<div class="info gold"><b>خطوات القراءة والفهم</b><p>① استمع للمقطع كاملًا. ② اقرأ كل جملة مع ترجمتها. ③ أعد القراءة دون ترجمة. ④ أجب عن 10 أسئلة متنوعة، ولا تحتاج إلى ترتيب كلمات في هذه المرحلة.</p></div><h2>اقرأ وافهم كل جملة</h2><div class="passage">${s.lines.map((line,j)=>`<div class="sentence"><div class="en">${esc(line)}</div><div class="ar">${esc(T[i][j])}</div><button class="btn tiny soft" onclick='speak(${JSON.stringify(line)})'>🔊 الجملة</button> <button class="btn tiny secondary" onclick='speak(${JSON.stringify(line)},true)'>ببطء</button></div>`).join('')}</div><div class="info"><b>تدريبات فهم القراءة · 10 أسئلة</b><p>اختيار متعدد (4)، صح أو خطأ (2)، إكمال الفراغ (2)، ربط (1)، إجابة قصيرة (1). المطلوب 8 من 10 للانتقال.</p></div>${qs.map((q,j)=>readingQuestionHTML(q,j,i)).join('')}<div id="readResult" aria-live="polite"></div><div class="actions"><button class="btn blue" onclick="checkReading(${i})">صحّح إجابات القراءة</button></div>`}
function checkReading(i){const qs=READ_Q[i];let n=0;const missing=[];qs.forEach((q,j)=>{const key='r'+i+'_'+j;const value=practice[key];if(q.type==='match'){if(Object.keys(readingPairs[key]||{}).length!==3)missing.push(j+1)}else if(!String(value??'').trim())missing.push(j+1)});if(missing.length){const r=$('#readResult');r.innerHTML=`<div class="result fail"><b>أسئلة لم تكتمل</b><p>أكمل الأسئلة التالية قبل التصحيح: ${missing.join('، ')}.</p></div>`;r.scrollIntoView({behavior:'smooth',block:'center'});return}
 qs.forEach((q,j)=>{const key='r'+i+'_'+j;const ok=q.type==='match'?q.pairs.every((p,k)=>(readingPairs[key]||{})[k]===k):String(practice[key]||'').trim().toLowerCase()===String(q.a).trim().toLowerCase();if(ok)n++;const f=document.getElementById('feedback_'+key);if(f)f.innerHTML=`<div class="feedback ${ok?'':'bad'}">${ok?'✓ إجابة صحيحة':'✗ الإجابة الصحيحة: '+esc(q.type==='match'?q.pairs.map(p=>p[0]+' = '+p[1]).join('، '):q.a)}</div>`});
 const r=$('#readResult');r.innerHTML=`<div class="result ${n>=8?'':'fail'}"><b>${n} / 10</b><p>${n>=8?'أحسنت! فهمت هذا المقطع ويمكنك الانتقال.':'راجع الجمل وترجمتها وإجاباتك ثم حاول مرة أخرى. درجة الإتقان 8/10.'}</p><div class="actions">${n>=8?`<button class="btn" onclick="unlock(${i+4})">${i===2?'الانتقال للتقييم النهائي':'المقطع التالي'} ←</button>`:''}<button class="btn secondary" onclick="retryReading(${i})">إعادة التدريب</button></div></div>`;r.scrollIntoView({behavior:'smooth',block:'center'})}
function retryReading(i){for(let j=0;j<READ_Q[i].length;j++){const key='r'+i+'_'+j;delete practice[key];delete readingPairs[key];delete readingSelected[key]}render()}

// Twenty distinct questions, each worth 0.5 mark: total 10 marks.
const FINAL=[
{type:'mc',skill:'Vocabulary',q:'Which adjective describes someone who is not afraid?',ar:'اختر الصفة التي تعني شجاعًا.',opts:['brave','quiet','polite','lazy'],a:'brave'},
{type:'mc',skill:'Vocabulary in context',q:'Sara always says “please” and “thank you”. She is _____.',ar:'اختر الصفة المناسبة لشخص مهذب في التعامل.',opts:['polite','loud','crazy','quiet'],a:'polite'},
{type:'mc',skill:'Vocabulary in context',q:'Ali works hard every day. He is _____.',ar:'اختر الصفة المناسبة لمن يعمل بجد.',opts:['hardworking','funny','brave','loud'],a:'hardworking'},
{type:'mc',skill:'Listening: word',q:'Listen and choose the correct word.',ar:'استمع للكلمة ثم اختر ما سمعته.',audio:'creative',opts:['creative','clever','active','friendly'],a:'creative'},
{type:'mc',skill:'Listening: sentence',q:'Listen. Which sentence do you hear?',ar:'استمع للجملة واختر الجملة المطابقة للصوت.',audio:'My best friend is very kind.',opts:['My best friend is very kind.','My best friend is very quiet.','My sister is very kind.','My best friend is very loud.'],a:'My best friend is very kind.'},
{type:'mc',skill:'Reading: Dave',q:'Why does Dave laugh?',ar:'من النص الأول: لماذا يضحك ديف؟',opts:['Biruk is funny.','Biruk is quiet.','They always agree.','Ron tells jokes.'],a:'Biruk is funny.'},
{type:'tf',skill:'Reading: Dave',q:'Dave and Biruk are both active, but they are different in some ways.',ar:'من النص الأول: كلاهما نشيط، لكنهما مختلفان في بعض الأمور. صحيح أم خطأ؟',a:'True'},
{type:'mc',skill:'Reading: Kyle',q:'Why are Kyle and Ron good friends?',ar:'من النص الثاني: ما السبب المذكور لصداقتهما الجيدة؟',opts:['Ron knows Kyle very well.','They play football all the time.','They are brothers.','They live in different cities.'],a:'Ron knows Kyle very well.'},
{type:'tf',skill:'Reading: Kyle',q:'Kyle and Ron meet only once a month.',ar:'من النص الثاني: يلتقي كايل ورون مرة واحدة شهريًا فقط. صحيح أم خطأ؟',a:'False'},
{type:'mc',skill:'Reading: Jasmine',q:'Which TWO qualities describe Camille?',ar:'من النص الثالث: اختر الصفتين اللتين تصفان كاميل.',opts:['hardworking and creative','loud and crazy','quiet and brave','active and funny'],a:'hardworking and creative'},
{type:'mc',skill:'Reading: Jasmine',q:'How does Camille treat Jasmine?',ar:'من النص الثالث: كيف تعامل كاميل أختها؟',opts:['She is always nice to her.','She ignores her.','She makes her angry.','She never understands her.'],a:'She is always nice to her.'},
{type:'tf',skill:'True or False',q:'A person who is quiet usually makes a lot of noise.',ar:'الشخص الهادئ يصدر عادةً ضوضاء كثيرة. صحيح أم خطأ؟',a:'False'},
{type:'gap',skill:'Complete the sentence',q:'My friend helps everyone. He is _____.',ar:'أكمل الفراغ بصفة تعني طيبًا ويساعد الآخرين.',opts:['kind','crazy','loud','lazy'],a:'kind'},
{type:'gap',skill:'Complete the sentence',q:'Biruk is loud, but Dave is _____.',ar:'أكمل الجملة بالصفة المقابلة لكلمة loud من النص الأول.',opts:['quiet','funny','active','smart'],a:'quiet'},
{type:'short',skill:'Write a word',q:'Complete: Jasmine says Camille is hardworking and _____.',ar:'اكتب كلمة واحدة صحيحة من النص الثالث لإكمال العبارة.',a:'creative'},
{type:'short',skill:'Write a word',q:'Complete: Kyle tells Ron all his _____.',ar:'اكتب كلمة واحدة صحيحة من النص الثاني لإكمال العبارة.',a:'problems'},
{type:'match',skill:'Matching',q:'Match each adjective to its meaning.',ar:'صل الكلمات الأربع بمعانيها الصحيحة؛ جميعها مطلوبة لنيل نصف الدرجة.',pairs:[['active','نشيط'],['kind','طيب'],['smart','ذكي'],['friendly','ودود']]},
{type:'order',skill:'Sentence order',q:'Build a correct sentence from the mixed words.',ar:'رتب الكلمات المختلطة لتكوين جملة صحيحة عن الصديق.',tokens:['kind','is','My','friend','.'],a:'My friend is kind.'},
{type:'order',skill:'Sentence order',q:'Build a correct sentence from the mixed words.',ar:'رتب الكلمات المختلطة لتكوين جملة صحيحة من درس القراءة.',tokens:['day','every','talk','We','.'],a:'We talk every day.'},
{type:'mc',skill:'Apply vocabulary',q:'Someone who has many new ideas is _____.',ar:'أي صفة تصف شخصًا لديه أفكار جديدة ومبتكرة؟',opts:['creative','quiet','polite','active'],a:'creative'}
];
const FINAL_MARK=0.5;
function initFinal(){if(quiz._init)return;quiz._init=true;quiz.orders={};quiz.matches={};quiz.selected={}}
function finalQuiz(){initFinal();let passages=`<div class="info gold"><b>نصوص القراءة للاختبار</b><p>اقرأ المقاطع الإنجليزية الثلاثة بعناية. تتناول الأسئلة فهم المعنى والصفات والأحداث، وليس حفظ الأسماء.</p></div>${S.map((s,i)=>`<details style="margin:9px 0;border:1px solid #dce9e4;border-radius:11px;padding:11px"><summary style="cursor:pointer;font-weight:900">${esc(s.name)} · Reading ${i+1}</summary><p class="en" style="text-align:left;font-size:19px">${esc(s.lines.join(' '))}</p><button class="btn tiny soft" onclick='speak(${JSON.stringify(s.lines.join(' '))})'>🔊 Listen</button></details>`).join('')}`;
return `<div class="info"><b>التقييم النهائي الشامل — 10 درجات</b><p>20 فقرة متنوعة × نصف درجة. يشمل: مفردات في السياق، استماعًا، فهم المقاطع الثلاثة، صح وخطأ، إكمالًا، كتابة كلمة، ربطًا وترتيب جمل. كل سؤال يوضح المطلوب بالعربية. حد الإتقان 8/10.</p></div>${audioBar()}${passages}${FINAL.map((q,i)=>finalQuestion(q,i)).join('')}<div id="finalResult" aria-live="polite"></div><div class="actions"><button class="btn blue" onclick="gradeFinal()">تصحيح التقييم من 10 درجات</button></div>`}
function finalChoice(i,value,button){if(submitted)return;quiz[i]=value;const host=button.closest('.question');host.querySelectorAll('.choice').forEach(b=>{b.classList.remove('chosen');b.setAttribute('aria-pressed','false')});button.classList.add('chosen');button.setAttribute('aria-pressed','true')}
function finalText(i,value){if(submitted)return;quiz[i]=value}
function finalQuestion(q,i){let val=quiz[i];const opts=q.type==='tf'?rotateOptions(['True','False'],i):rotateOptions(q.opts||[],i+31);let content='';
if(['mc','tf','gap'].includes(q.type))content=`<div class="choices">${opts.map(o=>`<button type="button" class="choice ${val===o?'chosen':''}" aria-pressed="${val===o}" onclick='finalChoice(${i},${JSON.stringify(o)},this)'>${q.type==='tf'?(o==='True'?'True — صحيح':'False — خطأ'):esc(o)}</button>`).join('')}</div>`;
else if(q.type==='short')content=`<input class="field en" dir="ltr" style="max-width:420px;font-size:21px" placeholder="اكتب الكلمة الإنجليزية" value="${esc(val||'')}" oninput="finalText(${i},this.value)" autocomplete="off" spellcheck="false">`;
else if(q.type==='order')content=orderHTML(i);
else content=matchHTML(q,i);
return `<div class="question" id="finalQuestion${i}"><span class="qnum">${i+1} / ${FINAL.length} · ${q.skill} · 0.5 MARK</span><h3 class="en" style="text-align:left">${esc(q.q)}</h3><p class="instruction">${esc(q.ar)}</p>${q.audio?`<button class="btn tiny soft" onclick='speak(${JSON.stringify(q.audio)})'>🔊 استمع</button> <button class="btn tiny secondary" onclick='speak(${JSON.stringify(q.audio)},true)'>استمع ببطء</button>`:''}${content}</div>`}
function mixedIndices(tokens,i){const arr=tokens.map((_,j)=>j);let seed=(i+17)*2467;for(let j=arr.length-1;j>0;j--){seed=(Math.imul(seed,1664525)+1013904223)>>>0;const k=seed%(j+1);[arr[j],arr[k]]=[arr[k],arr[j]]}const target=tokens.join(' ');if(arr.map(k=>tokens[k]).join(' ')===target)arr.reverse();return arr}
function orderHTML(i){let chosen=quiz.orders[i]||[],tokens=FINAL[i].tokens;return `<p class="muted">اضغط الكلمات من المجموعة المختلطة لتكوين الجملة. اضغط على كلمة في إجابتك لإزالتها.</p><div class="slot" id="orderSlot${i}">${chosen.map((idx,j)=>`<button type="button" class="token" onclick="removeToken(${i},${j})">${esc(tokens[idx])} ×</button>`).join('')}</div><div class="tokens" id="orderTokens${i}">${mixedIndices(tokens,i).map(idx=>`<button type="button" class="token ${chosen.includes(idx)?'used':''}" ${chosen.includes(idx)?'disabled':''} onclick="addToken(${i},${idx})">${esc(tokens[idx])}</button>`).join('')}</div><button class="btn tiny secondary" onclick="clearOrder(${i})">إعادة الترتيب</button>`}
function updateOrder(i){const host=document.getElementById('finalQuestion'+i);if(!host)return;const temp=document.createElement('div');temp.innerHTML=orderHTML(i);const slot=host.querySelector('.slot'),tokens=host.querySelector('.tokens');if(slot)slot.innerHTML=temp.querySelector('.slot').innerHTML;if(tokens)tokens.innerHTML=temp.querySelector('.tokens').innerHTML}
function addToken(i,k){if(submitted)return;const a=quiz.orders[i]||(quiz.orders[i]=[]);if(a.includes(k))return;a.push(k);updateOrder(i)}
function removeToken(i,j){if(submitted)return;(quiz.orders[i]||[]).splice(j,1);updateOrder(i)}
function clearOrder(i){if(submitted)return;quiz.orders[i]=[];updateOrder(i)}
function matchHTML(q,i){const order=mixedIndices(q.pairs,i+9);const m=quiz.matches[i]||{};return `<p class="muted">اختر الكلمة من العمود الأيمن ثم معناها من العمود الأيسر. يمكنك تغيير اختيارك قبل التصحيح.</p><div class="matchgrid" id="finalMatch${i}"><div class="matchcol"><b>English</b>${q.pairs.map((p,j)=>`<button type="button" data-word="${j}" class="matchtile en ${quiz.selected[i]===j?'focus':''} ${m[j]!==undefined?'paired':''}" onclick="selectWord(${i},${j})">${esc(p[0])} ${m[j]!==undefined?'✓':''}</button>`).join('')}</div><div class="matchcol"><b>العربية</b>${order.map(k=>`<button type="button" data-meaning="${k}" class="matchtile ${Object.values(m).includes(k)?'paired':''}" onclick="chooseArabic(${i},${k})">${esc(q.pairs[k][1])}</button>`).join('')}</div></div><p class="muted" id="finalMatchCount${i}">${Object.keys(m).length}/${q.pairs.length} روابط مكتملة</p>`}
function updateFinalMatch(i){const host=document.getElementById('finalQuestion'+i);if(!host)return;const temp=document.createElement('div');temp.innerHTML=matchHTML(FINAL[i],i);const current=host.querySelector('.matchgrid');if(current)current.innerHTML=temp.querySelector('.matchgrid').innerHTML;const count=document.getElementById('finalMatchCount'+i);if(count)count.textContent=Object.keys(quiz.matches[i]||{}).length+'/'+FINAL[i].pairs.length+' روابط مكتملة'}
function selectWord(i,j){if(submitted)return;quiz.selected[i]=j;updateFinalMatch(i)}
function chooseArabic(i,k){if(submitted)return;const j=quiz.selected[i];if(j===undefined||j===null)return;const m=quiz.matches[i]||(quiz.matches[i]={});for(const x of Object.keys(m))if(m[x]===k)delete m[x];m[j]=k;quiz.selected[i]=null;updateFinalMatch(i)}
function normalizeShort(v){return String(v??'').trim().toLowerCase().replace(/[.!?]/g,'').replace(/\s+/g,' ')}
function gradeFinal(){if(submitted)return;const missing=[];FINAL.forEach((q,i)=>{if(['mc','tf','gap','short'].includes(q.type)&&!String(quiz[i]??'').trim())missing.push(i+1);if(q.type==='order'&&(quiz.orders[i]||[]).length!==q.tokens.length)missing.push(i+1);if(q.type==='match'&&Object.keys(quiz.matches[i]||{}).length!==q.pairs.length)missing.push(i+1)});if(missing.length){const el=$('#finalResult');el.innerHTML=`<div class="result fail"><b>أكمل الأسئلة أولًا</b><p>الأسئلة غير المكتملة: ${missing.join('، ')}</p></div>`;el.scrollIntoView({behavior:'smooth',block:'center'});return}
let points=0,feedback=[];FINAL.forEach((q,i)=>{let ok=false;if(['mc','tf','gap'].includes(q.type))ok=quiz[i]===q.a;else if(q.type==='short')ok=normalizeShort(quiz[i])===normalizeShort(q.a);else if(q.type==='match')ok=q.pairs.every((p,j)=>(quiz.matches[i]||{})[j]===j);else if(q.type==='order')ok=(quiz.orders[i]||[]).map(x=>q.tokens[x]).join(' ').replace(/\s+([.!?])/g,'$1')===q.a;if(ok)points+=FINAL_MARK;else feedback.push(`${i+1}. ${q.type==='match'?q.pairs.map(p=>p[0]+' = '+p[1]).join('، '):q.a}`)});state.score=points;state.passed=points>=8;persist();submitted=true;$('#finalResult').innerHTML=`<div class="result ${points>=8?'':'fail'}"><b>${points.toFixed(1)} / 10</b><p>${points>=8?'أحسنت! حققت معيار الإتقان.':'راجع المهارات ثم أعد المحاولة. معيار الإتقان 8 من 10.'}</p>${feedback.length?`<details><summary>مراجعة الأخطاء (${feedback.length})</summary>${feedback.map(t=>`<p>${esc(t)}</p>`).join('')}</details>`:''}<div class="actions">${points>=8?'<button class="btn" onclick="unlock(7)">عرض شهادة الإتقان ←</button>':''}<button class="btn secondary" onclick="retryFinal()">إعادة التقييم</button></div></div>`;$('#finalResult').scrollIntoView({behavior:'smooth',block:'center'})}
function retryFinal(){quiz={};submitted=false;render()}
function certificate(){if(!state.passed)return `<div class="info gold">يجب إكمال التقييم بنجاح أولًا.</div>`;return `<div class="cert"><div class="eyebrow" style="color:#087969">TECHNICAL & VOCATIONAL TRAINING CORPORATION</div><h1>Certificate of Mastery</h1><h2>شهادة إتقان الدرس</h2><p>تُمنح هذه الشهادة للمتدرب</p><div class="name">${esc(state.name)}</div><p>المجموعة: ${esc(state.group)}</p><p>لإتقانه مهارات Unit 5 – Friends</p><h2>${state.score} / 10</h2><p>Vocabulary · Listening · Reading · Sentence Skills</p><p>Trainer: ADEL ALSMAEEL</p><p>${new Date().toLocaleDateString('en-GB')}</p></div><div class="actions"><button class="btn" onclick="window.print()">🖨️ طباعة الشهادة / حفظ PDF</button><button class="btn secondary" onclick="go(6)">مراجعة التقييم</button></div>`}
render();
