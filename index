const PREP=[{q:'Which word means "ودود"?',opts:['friendly','quiet','brave'],a:'friendly'},{q:'Which word means "مجتهد"?',opts:['creative','hardworking','funny'],a:'hardworking'},{q:'Which word describes a person who helps others?',opts:['kind','crazy','quiet'],a:'kind'},{q:'Which word means "مهذب"?',opts:['active','polite','clever'],a:'polite'},{q:'A person who makes us laugh is ...',opts:['funny','smart','brave'],a:'funny'},{q:'Which word means "مبدع"?',opts:['creative','friendly','active'],a:'creative'}];

function arabicPrompt(q){
 const t=String(q).toLowerCase();
 if(t.includes('best friend'))return 'من هو الصديق المقرّب للشخص المذكور؟ اقرأ النص ثم اختر الإجابة.';
 if(t.includes('what do dave'))return 'ما الرياضة التي يلعبها ديف وبيروك معًا؟';
 if(t.includes('where does'))return 'أين تعيش عائلة رون؟';
 if(t.includes('how often'))return 'كم مرة يلتقي كايل ورون؟';
 if(t.includes('who is camille'))return 'ما صلة قرابة كاميل بجاسمين؟';
 if(t.includes('who makes him laugh'))return 'من الشخص الذي يجعل ديف يضحك؟';
 if(t.includes('which adjective means'))return 'اختر الصفة الإنجليزية التي تحمل المعنى العربي المذكور.';
 if(t.includes('please')&&t.includes('thank you'))return 'اختر الصفة المناسبة لشخص يقول: من فضلك، وشكرًا.';
 if(t.includes('listen and choose'))return 'اضغط استمع، ثم اختر الكلمة التي تسمعها.';
 if(t.includes('listen:')||t.includes('speaker say'))return 'استمع للجملة الإنجليزية ثم اختر الجملة المطابقة للصوت.';
 if(t.includes('match each'))return 'صل كل كلمة إنجليزية بمعناها العربي من العمود المقابل.';
 if(t.includes('arrange the words'))return 'اضغط الكلمات بالترتيب الصحيح لتكوين جملة إنجليزية مفيدة.';
 if(t.includes('_____'))return 'اختر الكلمة المناسبة لإكمال الفراغ في الجملة.';
 if(t.includes('true')||t.includes('false')||t.includes('says')||t.includes('is quiet')||t.includes('is hardworking')||t.includes('tells ron'))return 'اقرأ العبارة ثم اختر: True (صحيح) أو False (خطأ).';
 if(t.includes('also')||t.includes('makes dave'))return 'أكمل المعنى من خلال النص واختر الكلمة الصحيحة.';
 return 'اقرأ السؤال الإنجليزي، واستعن بالنص والترجمة، ثم اختر الإجابة المناسبة.';
}

function choiceBlock(q,i,group='p'){let v=(group==='p'?practice:quiz)[i];return `<div class="question"><span class="qnum">QUESTION ${i+1}</span><h3 class="en" style="text-align:left">${esc(q.q)}</h3><p class="instruction">${esc(arabicPrompt(q.q))}</p>${q.audio?`<button class="btn tiny soft" onclick='speak(${JSON.stringify(q.audio)})'>🔊 استمع</button>`:''}<div class="choices">${q.opts.map(o=>`<button class="choice ${v===o?'chosen':''}" onclick='setAnswer(${JSON.stringify(group)},${i},${JSON.stringify(o)})'>${esc(o)}</button>`).join('')}</div></div>`}
function refreshKeepingPlace(){const y=window.scrollY;const focused=document.activeElement;const label=focused?.getAttribute("onclick");render();window.scrollTo({top:y,behavior:"instant"});if(label){const el=[...document.querySelectorAll("button")].find(b=>b.getAttribute("onclick")===label);if(el)el.focus({preventScroll:true})}}
function setAnswer(g,i,v){if(submitted)return;(g==='p'?practice:quiz)[i]=v;refreshKeepingPlace()}
function vocabPractice(){return `<div class="info"><b>مراجعة قبل القراءة</b><p>ستة أسئلة مختلفة، كل سؤال يقيس معنى أو استخدامًا محددًا. أجب عن 5 من 6 على الأقل لفتح القراءة.</p></div>${PREP.map((q,i)=>choiceBlock(q,i)).join('')}<div id="prepResult"></div><div class="actions"><button class="btn blue" onclick="checkPrep()">تحقق من إجاباتي</button></div>`}
function checkPrep(){let score=PREP.filter((q,i)=>practice[i]===q.a).length;$('#prepResult').innerHTML=`<div class="result ${score>=5?'':'fail'}"><b>${score}/6</b><p>${score>=5?'أحسنت! يمكنك البدء بالقراءة.':'راجع المفردات وأعد المحاولة. ستظهر الإجابات التي تحتاج مراجعتها.'}</p>${PREP.map((q,i)=>practice[i]!==q.a?`<p class="en" style="text-align:left">${esc(q.q)} → <b>${esc(q.a)}</b></p>`:'').join('')}${score>=5?'<button class="btn" onclick="unlock(3)">ابدأ القراءة ←</button>':''}</div>`}
