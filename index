function enter(){let n=$('#student').value.trim(),g=$('#group').value.trim();if(n.length<3||!g){$('#entryError').textContent='اكتب الاسم (3 أحرف على الأقل) والمجموعة.';return}if(state.name!==n||state.group!==g){state={name:n,group:g,unlocked:0,stage:0,score:0,passed:false}}else{state.name=n;state.group=g}persist();render()}
function resetProfile(){if(!confirm('هل تريد تغيير المتدرب؟ سيُحفظ تقدم المتدرب الحالي على هذا الجهاز حتى بدء اسم جديد.'))return;state.name='';state.group='';render()}
function getVoices(){return ('speechSynthesis'in window)?speechSynthesis.getVoices().filter(v=>/^en([-_]|$)/i.test(v.lang)):[]}
function chooseVoice(){voices=getVoices();const pref=voices.find(v=>/google uk english male/i.test(v.name))||voices.find(v=>/male/i.test(v.name)&&/en[-_]gb/i.test(v.lang))||voices.find(v=>/en[-_]gb/i.test(v.lang))||voices[0];if(!voices.some(v=>v.name===voiceName))voiceName=pref?.name||'';let sel=$('#voices');if(sel){sel.innerHTML=voices.length?voices.map(v=>`<option value="${esc(v.name)}">${esc(v.name)} (${esc(v.lang)})</option>`).join(''):'<option>Default browser voice</option>';sel.value=voiceName}}
if('speechSynthesis'in window)speechSynthesis.onvoiceschanged=chooseVoice;
function speak(t,slow=false){if(!('speechSynthesis'in window)){alert('النطق غير مدعوم في هذا المتصفح. استخدم Chrome أو Edge.');return}speechSynthesis.cancel();let u=new SpeechSynthesisUtterance(t),v=getVoices().find(v=>v.name===voiceName);u.lang='en-GB';if(v){u.voice=v;u.lang=v.lang}u.rate=slow?.73:.9;u.pitch=1;speechSynthesis.speak(u)}
function audioBar(){return `<div class="audioBar"><b>🔊 صوت الاستماع</b><select id="voices" aria-label="اختيار الصوت" onchange="voiceName=this.value"></select><button class="btn tiny soft" onclick="speak('My best friend is kind and smart.')">تجربة الصوت</button><small class="muted">Google UK English Male عند توفره</small></div>`}
function shell(html){let nav=STAGES.map((s,i)=>`<button class="${state.stage===i?'current':''} ${i<state.unlocked?'done':''}" ${i>state.unlocked?'disabled':''} onclick="go(${i})"><span class="num">${i<state.unlocked?'✓':i+1}</span><span>${s}</span></button>`).join('');return `<div class="layout"><aside class="side"><div class="eyebrow" style="color:#087969">YOUR LEARNING PATH</div><h3>رحلة إتقان الدرس</h3><div class="muted" style="font-size:14px">${esc(state.name)} · ${esc(state.group)}</div><div class="progress"><div style="width:${Math.min(100,state.unlocked/7*100)}%"></div></div><div class="nav">${nav}</div><div class="info gold" style="font-size:14px">المراحل تُفتح بالتدريج بعد التدريب. التقييم النهائي من 10 درجات.</div><button class="btn tiny secondary" onclick="resetProfile()">تغيير المتدرب</button></aside><section class="panel"><div class="headline"><div><span class="tag">STEP ${state.stage+1} / 8</span><h1>${STAGES[state.stage]}</h1></div><span class="tag en">FRIENDS</span></div>${html}</section></div>`}
function render(){if(!state.name){$('#app').innerHTML=`<div class="onboard"><section class="hero"><div class="eyebrow">TECHNICAL & VOCATIONAL TRAINING CORPORATION</div><h1>Unit 5<br>Friends.</h1><p>Learn words. Understand stories. Speak with confidence.</p><div class="chips"><span>12 adjectives</span><span>3 reading texts</span><span>British listening</span><span>10-mark assessment</span></div></section><section class="enroll"><span class="tag">WELCOME</span><h2>ابدأ رحلة الإتقان</h2><p class="muted">تعلم بالصور والشرح والاستماع، ثم اقرأ النصوص مع ترجمتها، واختبر مهاراتك.</p><label for="student">اسم المتدرب</label><input id="student" class="field" placeholder="الاسم الثلاثي" value="${esc(state.name)}"><label for="group">المجموعة التدريبية</label><input id="group" class="field" placeholder="مثال: المجموعة الأولى" value="${esc(state.group)}"><div id="entryError" style="color:#b94336;min-height:22px"></div><button class="btn" onclick="enter()">ابدأ التعلم ←</button><p class="muted" style="font-size:13px">Trainer: ADEL ALSMAEEL</p></section></div>`;return}
